  <Source dwd:design-time-name="471f4f2b-3bed-4d44-99c1-719e63d1efc7">
    <DataSourceViewID>Adventure Works DW2019</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="00000000-0000-0000-0000-000000000000">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 

/* Gross Profit Margin % */
CREATE MEMBER CURRENTCUBE.[Measures].[Gross Profit Margin] AS 
    IIF([Measures].[Sales Amount] = 0 OR IsEmpty([Measures].[Sales Amount]), 
        NULL, 
        ([Measures].[Sales Amount] - [Measures].[Total Product Cost]) / [Measures].[Sales Amount]
    ), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;

/* Average Order Value (AOV) */
CREATE MEMBER CURRENTCUBE.[Measures].[Average Order Value] AS 
    IIF([Measures].[Order Quantity] = 0 OR IsEmpty([Measures].[Order Quantity]), 
        NULL, 
        [Measures].[Sales Amount] / [Measures].[Order Quantity]
    ), 
FORMAT_STRING = "Currency", 
VISIBLE = 1;

/* Discount Ratio */
CREATE MEMBER CURRENTCUBE.[Measures].[Discount Ratio] AS 
    IIF([Measures].[Extended Amount] = 0 OR IsEmpty([Measures].[Extended Amount]), 
        NULL, 
        [Measures].[Discount Amount] / [Measures].[Extended Amount]
    ), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;

/* Sales Target Status */
CREATE MEMBER CURRENTCUBE.[Measures].[Sales Target Status] AS 
    IIF([Measures].[Sales Amount] &gt;= 500000, 
        1,  
        IIF([Measures].[Sales Amount] &gt;= 100000, 
            0,  
            -1  
        )
    ), 
VISIBLE = 1;

/* Gross Profit Amount */
CREATE MEMBER CURRENTCUBE.[Measures].[Gross Profit Amount] AS 
    [Measures].[Sales Amount] - [Measures].[Total Product Cost], 
FORMAT_STRING = "Currency", 
VISIBLE = 1;

/* Net Profit Amount */
CREATE MEMBER CURRENTCUBE.[Measures].[Net Profit Amount] AS 
    [Measures].[Sales Amount] - [Measures].[Total Product Cost] - [Measures].[Tax Amt] - [Measures].[Freight], 
FORMAT_STRING = "Currency", 
VISIBLE = 1;

/* Effective Tax Rate */
CREATE MEMBER CURRENTCUBE.[Measures].[Effective Tax Rate] AS 
    IIF([Measures].[Sales Amount] = 0 OR IsEmpty([Measures].[Sales Amount]), 
        NULL, 
        [Measures].[Tax Amt] / [Measures].[Sales Amount]
    ), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;

/* Freight Cost Per Item */
CREATE MEMBER CURRENTCUBE.[Measures].[Freight Cost Per Item] AS 
    IIF([Measures].[Order Quantity] = 0 OR IsEmpty([Measures].[Order Quantity]), 
        NULL, 
        [Measures].[Freight] / [Measures].[Order Quantity]
    ), 
FORMAT_STRING = "Currency", 
VISIBLE = 1;
</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>