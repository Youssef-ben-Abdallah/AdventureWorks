@startuml C4_Component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")

title C4 Component Diagram (Level 3) - ASP.NET Core API Container
caption Internal components of the Ecom.Api and their external connections

' ── External Containers ───────────────────────────────────
Container_Ext(SPA, "React SPA", "React 19 / TypeScript 6", "Sends REST requests via Axios with JWT Bearer token.")

ContainerDb_Ext(OLTP, "SQL Server AdventureWorks2019", "SQL Server", "OLTP database with Sales, Production, Person, and Identity schemas.")
ContainerDb_Ext(DW, "SQL Server AdventureWorksDW_Sales", "SQL Server", "Star-schema data warehouse for sales analytics.")
ContainerDb_Ext(SSAS, "SSAS CubeAW2019", "Analysis Services", "Multidimensional OLAP cube exposing MDX measures and dimensions.")
Container_Ext(FS, "File System C:\\images\\product\\", "File System", "Product JPEG/PNG images served as static assets.")

' ── API Container ─────────────────────────────────────────
Container_Boundary(API, "ASP.NET Core API (.NET 9) — Ecom.Api") {

    ' ── Auth Component ────────────────────────────────────
    Component(AuthCtrl, "AuthController", "ASP.NET Core Controller", "POST /api/auth/login, /api/auth/register. Returns JWT Bearer token on success.")
    Component(JwtSvc, "JwtTokenService", "C# Service (IJwtTokenService)", "Generates and validates JWT tokens with configurable expiry and signing key.")
    Component(Identity, "ASP.NET Identity", "Identity Framework", "UserManager and SignInManager for credential validation and role management.")

    ' ── Catalog Component ─────────────────────────────────
    Component(CatCtrl, "CategoriesController", "ASP.NET Core Controller", "GET/POST/PUT/DELETE /api/categories. Requires [Authorize(Admin)].")
    Component(SubCatCtrl, "SubCategoriesController", "ASP.NET Core Controller", "GET/POST/PUT/DELETE /api/subcategories. Requires [Authorize].")
    Component(ProdCtrl, "ProductsController", "ASP.NET Core Controller", "GET /api/products (public). POST/PUT/DELETE require [Authorize(Admin)].")
    Component(CatRepo, "CategoryRepository", "C# Repository (ICategoryRepository)", "EF Core queries for categories via OltpDbContext.")
    Component(SubCatRepo, "SubCategoryRepository", "C# Repository (ISubCategoryRepository)", "EF Core queries for subcategories via OltpDbContext.")
    Component(ProdRepo, "ProductRepository", "C# Repository (IProductRepository)", "EF Core queries for products with category/subcategory joins.")

    ' ── Orders Component ──────────────────────────────────
    Component(OrdCtrl, "OrdersController", "ASP.NET Core Controller", "GET/POST /api/orders. Requires [Authorize]. Maps to Sales.SalesOrderHeader.")
    Component(OrdRepo, "OrderRepository", "C# Repository (IOrderRepository)", "Creates and queries orders mapped to Sales.SalesOrderHeader/Detail.")

    ' ── DW Analytics Component ────────────────────────────
    Component(DashCtrl, "DashboardController", "ASP.NET Core Controller", "GET /api/dashboard/{overview,products,customers,sales-team,shipping,details}. Requires [Authorize(Admin)].")
    Component(DashSvc, "DashboardService", "C# Service (IDashboardService)", "Executes EF Core LINQ aggregations against AnalyticsDbContext. Located in Services/Dashboard/.")
    Component(DwCtx, "AnalyticsDbContext", "EF Core DbContext", "Maps star-schema entities: SalesFact, CustomerDim, ProductDim, TerritoryDim, CurrencyDim, SalesPersonDim, ShipMethodDim.")

    ' ── OLAP Analytics Component ──────────────────────────
    Component(CubeCtrl, "CubeInsightsController", "ASP.NET Core Controller", "22 endpoints at /api/cubeinsights/*. No auth required (public analytics).")
    Component(OlapSvc, "OlapService", "C# Service (IOlapService)", "Builds and executes MDX queries via ADOMD.NET AdomdCommand. Resolves dimension IDs to human-readable names.")

    ' ── Static Files ──────────────────────────────────────
    Component(StaticMw, "Static Files Middleware", "ASP.NET Core Middleware", "Maps /images/product/ URL path to C:\\images\\product\\ physical path via UseStaticFiles().")

    ' ── Cross-cutting ─────────────────────────────────────
    Component(OltpCtx, "OltpDbContext", "EF Core DbContext (IdentityDbContext<AppUser>)", "Maps OLTP entities to existing AdventureWorks tables using explicit column renames. ExcludeFromMigrations() for pre-existing tables.")
    Component(DTOs, "DTO Records", "C# Records", "AuthDtos, CatalogDtos, DashboardDtos, OrderDtos. Controllers return DTOs, not entities.")
    Component(JwtMw, "JWT Bearer Middleware", "ASP.NET Core Middleware", "Validates Bearer tokens on every request. [Authorize] attribute enforces role-based access.")
}

' ── External Connections: SPA -> API ──────────────────────
Rel(SPA, AuthCtrl, "POST /api/auth/login, /register", "HTTP / JSON")
Rel(SPA, CatCtrl, "GET/POST/PUT/DELETE /api/categories", "HTTP / JSON / JWT")
Rel(SPA, SubCatCtrl, "GET /api/subcategories", "HTTP / JSON / JWT")
Rel(SPA, ProdCtrl, "GET/POST/PUT/DELETE /api/products", "HTTP / JSON")
Rel(SPA, OrdCtrl, "POST/GET /api/orders", "HTTP / JSON / JWT")
Rel(SPA, DashCtrl, "GET /api/dashboard/*", "HTTP / JSON / JWT (Admin)")
Rel(SPA, CubeCtrl, "GET /api/cubeinsights/*", "HTTP / JSON")
Rel(SPA, StaticMw, "GET /images/product/{filename}", "HTTP")

' ── Internal component relationships ──────────────────────
Rel(AuthCtrl, JwtSvc, "Requests token generation")
Rel(AuthCtrl, Identity, "Authenticates credentials")

Rel(CatCtrl, CatRepo, "Queries categories")
Rel(SubCatCtrl, SubCatRepo, "Queries subcategories")
Rel(ProdCtrl, ProdRepo, "Queries products")

Rel(OrdCtrl, OrdRepo, "Creates and queries orders")

Rel(DashCtrl, DashSvc, "Delegates analytics queries")
Rel(DashSvc, DwCtx, "Runs LINQ aggregations")

Rel(CubeCtrl, OlapSvc, "Delegates MDX queries")

Rel(CatRepo, OltpCtx, "Uses DbContext")
Rel(SubCatRepo, OltpCtx, "Uses DbContext")
Rel(ProdRepo, OltpCtx, "Uses DbContext")
Rel(OrdRepo, OltpCtx, "Uses DbContext")
Rel(Identity, OltpCtx, "Uses Identity tables")

' ── Components -> External data stores ────────────────────
Rel(OltpCtx, OLTP, "Queries/updates OLTP tables", "TDS / EF Core")
Rel(DwCtx, DW, "Queries DW star schema", "TDS / EF Core")
Rel(OlapSvc, SSAS, "Executes MDX queries", "XMLA / ADOMD.NET")
Rel(StaticMw, FS, "Reads product image files", "File I/O")

note bottom of API
    All controllers return DTOs — never raw entities.
    DI configured in Program.cs:
    - AddScoped<IRepo, Repo> for all repositories
    - AddScoped<IService, Service> for all services
    - AddDbContext<OltpDbContext>(OLTPConnection)
    - AddDbContext<AnalyticsDbContext>(AnalyticsConnection)
    - AddSingleton / AddScoped for JWT services
    Roles seeded on startup: "Admin", "User"
end note

footer AdventureWorks Sales BI Platform | C4 Component Diagram (Level 3) | Page %page% of %lastpage%

@enduml
