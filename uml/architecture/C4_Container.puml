@startuml C4_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")

title C4 Container Diagram (Level 2) - AdventureWorks Sales BI Platform
caption Containers within the system and their communication protocols

' ── Actors ────────────────────────────────────────────────
Person(CUSTOMER, "Customer", "Browses products and places orders via the SPA.")
Person(ADMIN, "Admin / Analyst", "Manages catalog and views analytics via the SPA.")

' ── System Boundary ───────────────────────────────────────
System_Boundary(SYSTEM, "AdventureWorks Sales BI Platform") {

    ' ── Frontend Container ────────────────────────────────
    Container(SPA, "React SPA", "React 19 / TypeScript 6 / Vite 8", "Single-page application providing product browsing, cart, orders, and analytics dashboards. Uses Recharts and React-Leaflet for data visualization.")

    ' ── Backend Container ─────────────────────────────────
    Container(API, "ASP.NET Core API", ".NET 9 / C#", "RESTful API providing product catalog, order management, DW analytics, and OLAP cube queries. JWT Bearer authentication via ASP.NET Identity.")

    ' ── ETL Container ─────────────────────────────────────
    Container(SSIS, "SSIS ETL Packages", "SQL Server Integration Services", "ETL pipeline executing 01_Load_Dimension.dtsx and 02_Load_FactSales.dtsx. Loads dimensions (SCD Type 1) and fact table from OLTP into the data warehouse via stored procedures.")

    ' ── Data Stores ───────────────────────────────────────
    ContainerDb(OLTP, "OLTP Database", "SQL Server (AdventureWorks2019)", "Transactional database storing products, categories, users, orders, and ASP.NET Identity tables. Managed by OltpDbContext.")

    ContainerDb(DW, "Analytics Data Warehouse", "SQL Server (AdventureWorksDW_Sales)", "Custom star schema with Sales fact table and 6 dimension tables. Includes vwSalesDashboard view. Managed by AnalyticsDbContext.")

    ContainerDb(SSAS, "SSAS Cube", "Analysis Services (CubeAW2019)", "Multidimensional OLAP cube with 8+ dimensions, 12 base measures, and 8 calculated members. Queried via MDX through ADOMD.NET.")

    ContainerDb(DW2019, "SSAS Source Database", "SQL Server (AdventureWorksDW2019)", "AdventureWorks DW 2019 database used as source for SSAS cube processing. Contains DimDate, DimProduct, FactResellerSales, and 8 more tables.")

    Container(IMAGES, "Product Image Store", "File System (C:\\images\\product\\)", "Product image files (JPEG/PNG) served as static assets by the API via ASP.NET Core StaticFiles middleware at /images/product/{filename}.")
}

' ── User Relationships ────────────────────────────────────
Rel(CUSTOMER, SPA, "Browses, orders", "HTTPS / Browser")
Rel(ADMIN, SPA, "Manages, analyzes", "HTTPS / Browser")

' ── Container Communication ───────────────────────────────
Rel(SPA, API, "All API calls (REST/JSON)", "HTTP / Axios + JWT Bearer")

Rel(API, OLTP, "Reads/writes OLTP entities", "TDS / EF Core OltpDbContext")
Rel(API, DW, "Reads analytics aggregations", "TDS / EF Core AnalyticsDbContext")
Rel(API, SSAS, "Executes MDX queries for cube insights", "XMLA / ADOMD.NET")
Rel(API, IMAGES, "Reads and streams product images", "File I/O / StaticFiles")

Rel(SSIS, OLTP, "Extracts transactional source data", "TDS / OLE DB")
Rel(SSIS, DW, "Loads dimensions and fact tables", "TDS / Stored Procedures")

Rel(SSAS, DW2019, "Processes cube from relational source", "TDS / OLE DB")

note bottom of SSIS
    Scheduled via SQL Server Agent
    or manual execution in Visual Studio.
    Run order: 01 (Dimensions) then 02 (Facts).
end note

note right of API
    Ports:
    HTTPS :57240
    HTTP  :57241
    Swagger: :57241/swagger
end note

note left of SPA
    Dev: Vite :5173
    Prod: Static build
    (npm run build)
end note

legend bottom right
    |= Protocol |= Description |
    | HTTP/HTTPS | REST API with JSON payloads |
    | TDS | SQL Server Tabular Data Stream |
    | XMLA | XML for Analysis via ADOMD.NET |
    | OLE DB | SSIS data source/destination connectors |
    | File I/O | Static file reading and streaming |
endlegend

footer AdventureWorks Sales BI Platform | C4 Container Diagram (Level 2) | Page %page% of %lastpage%

@enduml
