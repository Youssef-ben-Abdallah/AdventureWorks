@startuml C4_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

SHOW_PERSON_OUTLINE()
UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")

title C4 Context Diagram (Level 1) - AdventureWorks Sales BI Platform
caption System context showing users and external system boundaries

' ── Actors ────────────────────────────────────────────────
Person(CUSTOMER, "Customer", "Browses product catalog, manages shopping cart, places and tracks orders, views order history via the React SPA.")

Person(ADMIN, "Admin / Analyst", "Manages product catalog, views sales dashboards, analyzes DW analytics, and explores OLAP cube insights.")

' ── System ────────────────────────────────────────────────
System(SYSTEM, "AdventureWorks Sales BI Platform", "Full-stack e-commerce and BI platform built with ASP.NET Core .NET 9 API, React 19 SPA, SSIS ETL pipelines, and SSAS multidimensional cube. Provides product browsing, order management, sales analytics dashboards, and OLAP cube exploration.")

' ── External Systems ──────────────────────────────────────
System_Ext(SQLSERVER, "SQL Server", "Hosts three databases: AdventureWorks2019 (OLTP), AdventureWorksDW_Sales (custom DW star schema), and AdventureWorksDW2019 (SSAS source).")

System_Ext(SSAS, "SQL Server Analysis Services", "SSAS Multidimensional instance on localhost\\MSSQLSERVER0. Catalog: CubeAW2019. Provides pre-aggregated OLAP analytics via MDX queries (20 base + calculated measures).")

System_Ext(FS, "File System", "Product image storage at C:\\images\\product\\ served as static files via ASP.NET Core StaticFiles middleware.")

' ── Relationships ─────────────────────────────────────────
Rel(CUSTOMER, SYSTEM, "Browses products, places orders, views order history", "HTTPS")
Rel(ADMIN, SYSTEM, "Manages catalog, views dashboards, explores cube insights", "HTTPS")

Rel(SYSTEM, SQLSERVER, "Reads/writes transactional data and queries DW analytics", "TDS / TCP 1433")
Rel(SYSTEM, SSAS, "Executes MDX queries for multidimensional analytics", "XMLA / ADOMD.NET / TCP 2383")
Rel(SYSTEM, FS, "Reads and serves product images to browser clients", "File I/O")

Rel_Back(SSAS, SQLSERVER, "SSAS processes cube from AdventureWorksDW2019 source database", "TDS / OLE DB")

note right of CUSTOMER
    Browses product catalog
    Manages shopping cart
    Places and tracks orders
    Views order history
end note

note right of ADMIN
    Manages product catalog (CRUD)
    Views tabbed sales dashboards
    Analyzes DW-level analytics
    Explores OLAP cube insights
end note

footer AdventureWorks Sales BI Platform | C4 Context Diagram (Level 1) | Page %page% of %lastpage%

@enduml
