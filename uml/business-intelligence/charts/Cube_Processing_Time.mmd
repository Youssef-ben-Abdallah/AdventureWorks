%% Cube Processing Time
%% Bar chart comparing full vs incremental SSAS cube processing times.
%% Full processing ~45 min; incremental ~8 min.
%% Shows processing times at different cube sizes to justify incremental strategy.

---
config:
  theme: base
  themeVariables:
    xyChart:
      titleColor: "#333333"
      backgroundColor: "#ffffff"
---
xychart-beta
    title "SSAS Cube Processing Time: Full vs Incremental (minutes)"
    x-axis ["15K rows", "25K rows", "35K rows", "45K rows", "60K rows"]
    y-axis "Processing Time (minutes)" 0 --> 55
    bar "Full Processing" [22, 30, 36, 42, 48]
    bar "Incremental Processing" [3, 4, 5, 7, 8]
