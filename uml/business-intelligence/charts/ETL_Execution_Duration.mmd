%% ETL Execution Duration Trend
%% Shows monthly ETL execution times for dimension and fact table loads.
%% Dimension loads range 2-5 min; fact loads range 8-15 min.
%% Used in internship report to illustrate ETL performance characteristics.

---
config:
  theme: base
  themeVariables:
    xyChart:
      titleColor: "#333333"
      backgroundColor: "#ffffff"
---
xychart-beta
    title "ETL Execution Duration per Monthly Run (minutes)"
    x-axis ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    y-axis "Duration (minutes)" 0 --> 18
    bar "Dimension Load" [3, 2, 4, 3, 5, 3, 4, 2, 3, 4, 3, 2]
    bar "Fact Load" [12, 10, 14, 11, 15, 13, 12, 9, 11, 13, 10, 8]
