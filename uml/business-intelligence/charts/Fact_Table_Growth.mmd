%% Fact Table Row Count Growth
%% Line chart showing FactResellerSales row count growing from ~15K (2010) to ~60K (2013).
%% Demonstrates the transaction volume increase over the analysis period.

---
config:
  theme: base
  themeVariables:
    xyChart:
      titleColor: "#333333"
      backgroundColor: "#ffffff"
---
xychart-beta
    title "FactResellerSales Row Count Growth (2010-2013)"
    x-axis ["2010-Q1", "2010-Q2", "2010-Q3", "2010-Q4", "2011-Q1", "2011-Q2", "2011-Q3", "2011-Q4", "2012-Q1", "2012-Q2", "2012-Q3", "2012-Q4", "2013-Q1", "2013-Q2", "2013-Q3", "2013-Q4"]
    y-axis "Row Count (thousands)" 0 --> 65
    line "FactResellerSales" [15, 17, 19, 22, 25, 28, 31, 34, 37, 41, 44, 48, 51, 55, 58, 60]
