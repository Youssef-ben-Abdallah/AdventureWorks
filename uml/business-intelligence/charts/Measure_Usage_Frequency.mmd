%% Measure Usage Frequency
%% Horizontal bar chart showing which OLAP measures are queried most frequently.
%% Based on simulated query log analysis of the AdventureWorks SSAS cube.
%% Helps justify which measures to optimize and cache.

---
config:
  theme: base
  themeVariables:
    xyChart:
      titleColor: "#333333"
      backgroundColor: "#ffffff"
---
xychart-beta
    title "OLAP Measure Usage Frequency (%)"
    x-axis ["Sales Amount", "Order Qty", "Net Profit", "Freight", "Discount Amt", "Product Cost", "Extended Amt", "Tax Amt", "Profit Margin", "AOV"]
    y-axis "Query Frequency (%)" 0 --> 100
    bar "Usage %" [95, 78, 72, 65, 58, 55, 42, 38, 35, 30]
