@startuml CD_Controllers
!theme cerulean-outline

title AdventureWorks Sales BI Platform\nAPI Controllers

skinparam classAttributeIconSize 0
skinparam linetype ortho

' ─────────────────────────────────────────────
'  Base
' ─────────────────────────────────────────────
abstract class ControllerBase <<Framework>> #EEF2FF {
    # User : ClaimsPrincipal
    # Ok(value) : IActionResult
    # BadRequest(error) : IActionResult
    # NotFound() : IActionResult
    # Unauthorized() : IActionResult
}

' ─────────────────────────────────────────────
'  Dependencies (compact)
' ─────────────────────────────────────────────
package "Services & Repositories" <<Rectangle>> #F0FDF4 {
    interface ICategoryRepository <<Interface>>
    interface ISubCategoryRepository <<Interface>>
    interface IProductRepository <<Interface>>
    interface IOrderRepository <<Interface>>
    interface IJwtTokenService <<Interface>>
    interface IDashboardService <<Interface>>
    interface IOlapService <<Interface>>
    class "UserManager<AppUser>" as UserManager <<Framework>>
    class "SignInManager<AppUser>" as SignInManager <<Framework>>
}

' ─────────────────────────────────────────────
'  Controllers
' ─────────────────────────────────────────────
package "Ecom.Api.Controllers" <<Rectangle>> #EFF6FF {

    class AuthController <<ApiController>> {
        - _userManager : UserManager<AppUser>
        - _signInManager : SignInManager<AppUser>
        - _jwtTokenService : IJwtTokenService
        __
        + {method} <<AllowAnonymous>> Register(dto) : Task<IActionResult>
        + {method} <<AllowAnonymous>> Login(dto) : Task<IActionResult>
        + {method} <<Authorize>> Me() : Task<IActionResult>
    }

    class CategoriesController <<ApiController>> {
        - _repository : ICategoryRepository
        __
        + {method} <<Authorize>> GetAll() : Task<IActionResult>
        + {method} <<Authorize>> GetById(id) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Create(dto) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Update(id, dto) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Delete(id) : Task<IActionResult>
    }

    class SubCategoriesController <<ApiController>> {
        - _repository : ISubCategoryRepository
        __
        + {method} <<Authorize>> GetAll() : Task<IActionResult>
        + {method} <<Authorize>> GetById(id) : Task<IActionResult>
        + {method} <<Authorize>> GetByCategoryId(categoryId) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Create(dto) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Update(id, dto) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Delete(id) : Task<IActionResult>
    }

    class ProductsController <<ApiController>> {
        - _repository : IProductRepository
        __
        + {method} <<Authorize>> GetAll() : Task<IActionResult>
        + {method} <<Authorize>> GetById(id) : Task<IActionResult>
        + {method} <<Authorize>> GetPaged(query) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Create(dto) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Update(id, dto) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Delete(id) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> UploadImage(id, file) : Task<IActionResult>
    }

    class OrdersController <<ApiController>> {
        - _repository : IOrderRepository
        __
        + {method} <<Authorize>> GetMyOrders() : Task<IActionResult>
        + {method} <<Authorize>> CreateOrder(dto) : Task<IActionResult>
    }

    class DashboardController <<ApiController>> {
        - _dashboardService : IDashboardService
        __
        + {method} <<Authorize(Admin)>> Filters() : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Overview(query) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Products(query) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Customers(query) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> SalesTeam(query) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Shipping(query) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Details(query) : Task<IActionResult>
    }

    class CubeInsightsController <<ApiController>> {
        - _olapService : IOlapService
        __
        + {method} <<Authorize(Admin)>> Filters() : Task<IActionResult>
        + {method} <<Authorize(Admin)>> Kpis(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> ProfitAnalysis(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> SalesTrend(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> TopProducts(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> TerritorySales(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> FreightAnalysis(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> TargetStatus(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> ProductCostAnalysis(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> DiscountByProduct(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> OrderVolumeByProduct(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> PriceGapAnalysis(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> TerritoryDetail(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> EmployeeKpis(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> TopEmployees(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> EmployeeSalesByTerritory(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> EmployeeAov(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> PromotionKpis(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> SalesByPromotion(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> DiscountTrend(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> SalesByCurrency(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> FulfillmentKpis(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> ShippingVolume(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> FreightByTerritory(filters) : Task<IActionResult>
        + {method} <<Authorize(Admin)>> OrderShipLag(filters) : Task<IActionResult>
    }
}

' ─────────────────────────────────────────────
'  Inheritance
' ─────────────────────────────────────────────
ControllerBase <|-- AuthController
ControllerBase <|-- CategoriesController
ControllerBase <|-- SubCategoriesController
ControllerBase <|-- ProductsController
ControllerBase <|-- OrdersController
ControllerBase <|-- DashboardController
ControllerBase <|-- CubeInsightsController

' ─────────────────────────────────────────────
'  Dependencies
' ─────────────────────────────────────────────
AuthController --> UserManager : injects >
AuthController --> SignInManager : injects >
AuthController --> IJwtTokenService : injects >
CategoriesController --> ICategoryRepository : injects >
SubCategoriesController --> ISubCategoryRepository : injects >
ProductsController --> IProductRepository : injects >
OrdersController --> IOrderRepository : injects >
DashboardController --> IDashboardService : injects >
CubeInsightsController --> IOlapService : injects >

@enduml
