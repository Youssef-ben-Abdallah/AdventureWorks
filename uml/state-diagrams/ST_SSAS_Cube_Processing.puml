@startuml ST_SSAS_Cube_Processing
!theme cerulean-outline
title SSAS Cube Processing State (Adventure Works DW2019)
footer AdventureWorks Sales BI Platform

skinparam state {
  BackgroundColor<<unprocessed>> #FFCDD2
  BorderColor<<unprocessed>> #C62828
  BackgroundColor<<procdim>> #FFF9C4
  BorderColor<<procdim>> #F9A825
  BackgroundColor<<dimready>> #BBDEFB
  BorderColor<<dimready>> #1565C0
  BackgroundColor<<procmg>> #FFE0B2
  BorderColor<<procmg>> #E65100
  BackgroundColor<<ready>> #C8E6C9
  BorderColor<<ready>> #388E3C
  BackgroundColor<<incremental>> #E1BEE7
  BorderColor<<incremental>> #6A1B9A
  BackgroundColor<<error>> #F8BBD0
  BorderColor<<error>> #AD1457
}

[*] --> Unprocessed : Cube deployed\nor schema changed

state "Unprocessed" as Unprocessed <<unprocessed>> {
  Unprocessed : entry / invalidate all cached MDX results
  Unprocessed : do / block OlapService from executing queries
  Unprocessed : Cube has no data
  Unprocessed : All dimensions empty
  Unprocessed : Measure groups empty
  Unprocessed : MDX queries return no results
}

state "Processing Dimensions" as ProcessingDimensions <<procdim>> {
  ProcessingDimensions : entry / open ADOMD connection to Analysis Services
  ProcessingDimensions : do / process each dimension partition in parallel
  ProcessingDimensions : exit / verify all dimension keys are consistent
  ProcessingDimensions : Processing all 7 dimensions in parallel

  state forkDims #LightGray <<fork>>
  state joinDims #LightGray <<join>>

  state "Dim Date" as DimDate
  state "Dim Product" as DimProduct
  state "Dim Sales Territory" as DimTerritory
  state "Dim Employee" as DimEmployee
  state "Dim Promotion" as DimPromotion
  state "Dim Currency" as DimCurrency
  state "Dim Reseller" as DimReseller

  DimDate : [Order Date].[Calendar Year]
  DimDate : [Order Date].[Date]
  DimProduct : [Product].[Category] hierarchy
  DimProduct : Category -> Subcategory -> Product
  DimTerritory : [Sales Territory].[Sales Territory]
  DimTerritory : Group -> Country -> Region
  DimEmployee : [Employee].[Employee]
  DimPromotion : [Promotion].[Promotion]
  DimCurrency : [Currency].[Currency]
  DimReseller : [Reseller].[Reseller]

  [*] --> forkDims

  forkDims --> DimDate
  forkDims --> DimProduct
  forkDims --> DimTerritory
  forkDims --> DimEmployee
  forkDims --> DimPromotion
  forkDims --> DimCurrency
  forkDims --> DimReseller

  DimDate --> joinDims
  DimProduct --> joinDims
  DimTerritory --> joinDims
  DimEmployee --> joinDims
  DimPromotion --> joinDims
  DimCurrency --> joinDims
  DimReseller --> joinDims

  joinDims --> [*]
}

state "Dimensions Ready" as DimensionsReady <<dimready>> {
  DimensionsReady : entry / confirm all 7 dimension member counts > 0
  DimensionsReady : do / await measure group processing trigger
  DimensionsReady : All 7 dimensions processed
  DimensionsReady : Hierarchies populated:
  DimensionsReady : - Date: Year/Month/Day
  DimensionsReady : - Product: Cat/Sub/Product
  DimensionsReady : - Territory: Group/Country/Region
  DimensionsReady : Composite keys resolved
  DimensionsReady : Awaiting measure group processing
}

state "Processing Measure Group" as ProcessingMeasureGroup <<procmg>> {
  ProcessingMeasureGroup : entry / open partition scan on FactResellerSales
  ProcessingMeasureGroup : do / aggregate measures and build B-tree indexes
  ProcessingMeasureGroup : exit / validate row counts match DWH staging
  ProcessingMeasureGroup : Processing Fact Reseller Sales
  ProcessingMeasureGroup : partition(s)
  ProcessingMeasureGroup : Building aggregations
  ProcessingMeasureGroup : Linking to dimension keys

  state "Measures" as Measures {
    Measures : Sales Amount
    Measures : Total Product Cost
    Measures : Tax Amount
    Measures : Freight
    Measures : Order Quantity
    Measures : Extended Amount
    Measures : Unit Price Discount Pct
  }
}

state "Fully Processed" as FullyProcessed <<ready>> {
  FullyProcessed : entry / signal OlapService that cube is queryable
  FullyProcessed : do / serve MDX queries via AdomdConnection
  FullyProcessed : Cube ready for MDX queries
  FullyProcessed : All KPIs available:
  FullyProcessed : - Gross Profit Margin
  FullyProcessed : - AOV, Discount Ratio
  FullyProcessed : - Effective Tax Rate
  FullyProcessed : Drill-down paths active:
  FullyProcessed : - Monthly -> Daily
  FullyProcessed : - Category -> Subcategory -> Product
  FullyProcessed : - Group -> Country -> Region
  FullyProcessed : OlapService can serve
  FullyProcessed : CubeInsightsController endpoints
}

state "Incremental Update" as IncrementalUpdate <<incremental>> {
  IncrementalUpdate : entry / detect new partition data in DWH staging
  IncrementalUpdate : do / apply delta dimension + fact updates
  IncrementalUpdate : exit / refresh aggregations for changed partitions
  IncrementalUpdate : New data loaded via SSIS ETL
  IncrementalUpdate : into DWH staging tables
  IncrementalUpdate : Delta processing applies
  IncrementalUpdate : new facts + dimension changes
  IncrementalUpdate : without full reprocess
}

state "Processing Error" as ProcessingError <<error>> {
  ProcessingError : entry / log error details to Windows Event Log
  ProcessingError : do / surface error in SSMS Processing dialog
  ProcessingError : Dimension or measure group
  ProcessingError : processing failed
  ProcessingError : Possible causes:
  ProcessingError : - Data source unreachable
  ProcessingError : - Key errors / duplicates
  ProcessingError : - Memory exhaustion
  ProcessingError : - Timeout
}

Unprocessed --> ProcessingDimensions : [Admin initiates\nProcess Full]

ProcessingDimensions --> DimensionsReady : [All dimensions\nprocessed successfully]

ProcessingDimensions --> ProcessingError : [Dimension processing\nfails (key error,\nconnection error)]

DimensionsReady --> ProcessingMeasureGroup : [Process measure group\nFact Reseller Sales]

ProcessingMeasureGroup --> FullyProcessed : [Measure group\nprocessed successfully\nAggregations built]

ProcessingMeasureGroup --> ProcessingError : [Measure group fails\n(missing dimension key,\npartition error)]

FullyProcessed --> IncrementalUpdate : [New data arrives\nvia SSIS ETL pipeline\nProcess Update triggered]

IncrementalUpdate --> FullyProcessed : [Delta processed\nsuccessfully\nAggregations updated]

IncrementalUpdate --> ProcessingError : [Incremental update\nfails]

FullyProcessed --> Unprocessed : [Schema change detected]\nDimension attribute added/removed\nor measure group altered\nRequires full reprocess

ProcessingError --> Unprocessed : [Admin resolves issue\nand resets for\nfull reprocess]

ProcessingError --> ProcessingDimensions : [Admin retries\ndimension processing\nafter fixing data]

ProcessingError --> ProcessingMeasureGroup : [Admin retries\nmeasure group processing\nafter fixing data]

note right of FullyProcessed
  When Fully Processed, the
  OlapService connects via
  AdomdConnection and executes
  MDX queries against
  **[Adventure Works DW2019]** cube.

  Dimensions used:
  - [Order Date]
  - [Product]
  - [Sales Territory]
  - [Employee]
  - [Promotion]
  - [Currency]
  - [Reseller]
end note

note right of ProcessingDimensions
  The fork/join pseudostates
  model SSAS parallel dimension
  processing: all 7 dimensions
  are submitted concurrently
  and the join gate waits for
  every one to complete before
  the cube moves to DimensionsReady.
end note

note bottom of IncrementalUpdate
  SSIS ETL loads new data
  into the Data Warehouse
  (DWH2019). Incremental
  processing updates only
  changed partitions.
end note
@enduml
